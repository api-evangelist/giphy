{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-evangelist.github.io/giphy/json-schema/giphy-user-schema.json",
  "title": "GIPHY User",
  "type": "object",
  "description": "User or channel attached to GIPHY content.",
  "properties": {
    "avatar_url": { "type": "string", "format": "uri" },
    "banner_image": { "type": "string", "format": "uri" },
    "banner_url": { "type": "string", "format": "uri" },
    "profile_url": { "type": "string", "format": "uri" },
    "username": { "type": "string" },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "instagram_url": { "type": "string", "format": "uri" },
    "website_url": { "type": "string", "format": "uri" },
    "is_verified": { "type": "boolean" }
  }
}
